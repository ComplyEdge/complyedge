{
  "name": "trustlint",
  "version": "2.2.0",
  "description": "Offline linter that checks prompts and answers against AI laws before they ship: EU AI Act Art. 5 and Art. 50 and NYC Local Law 144, plus GDPR, HIPAA, SOX, PCI DSS and COPPA rules (63 bundled, regex). CLI and library. No API key, no network call.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "trustlint": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "eu-ai-act",
    "ai-act",
    "compliance",
    "compliance-linter",
    "ai-governance",
    "offline",
    "linter",
    "cli",
    "ci",
    "article-5",
    "gdpr",
    "hipaa",
    "sox",
    "pci-dss",
    "coppa",
    "trustlint",
    "complyedge",
    "ai-laws",
    "nyc-ll144"
  ],
  "author": "ComplyEdge <support@complyedge.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ComplyEdge/complyedge.git",
    "directory": "packages/trustlint"
  },
  "bugs": {
    "url": "https://github.com/ComplyEdge/complyedge/issues"
  },
  "homepage": "https://www.complyedge.io/docs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-rules.mjs",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run lint && npm run test"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
