{
  "name": "@complyedge/mcp",
  "version": "0.2.4",
  "description": "Offline MCP server that checks prompts and answers against AI laws, with the citation when a rule fires: EU AI Act Art. 5 and Art. 50, GPAI, NYC Local Law 144, plus GDPR and US privacy rules (63 bundled). Three read-only tools. Runs with npx: no Python, no API key, no network call. Setting COMPLYEDGE_API_KEY adds an optional hosted sandbox_check tool.",
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.ComplyEdge/complyedge",
  "type": "module",
  "bin": {
    "complyedge-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run type-check && npm run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "eu-ai-act",
    "ai-act",
    "ai-governance",
    "ai-compliance",
    "compliance",
    "prompt-scanning",
    "offline",
    "article-5",
    "article-50",
    "gdpr",
    "hipaa",
    "sox",
    "pci-dss",
    "coppa",
    "npx",
    "trustlint",
    "complyedge",
    "ai-laws",
    "nyc-ll144"
  ],
  "author": "ComplyEdge",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComplyEdge/complyedge.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/ComplyEdge/complyedge/issues"
  },
  "homepage": "https://www.complyedge.io/docs/quick-start.html",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "trustlint": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
