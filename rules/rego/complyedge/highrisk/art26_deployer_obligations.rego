# ComplyEdge: EU AI Act Article 26: Deployer Obligations
#
# A deployer running a high-risk AI system without following its instructions
# for use, without human oversight, without monitoring or without keeping its
# logs.
#
# Layer 1 detects: "deploy", "deploying" or "deployer", then "high-risk AI",
# then "without" with no word between, then "instructions", "oversight",
# "monitoring" or "logs"; and a word starting "ignor" or "disregard", "the"
# optional, then "instructions for use" or "deployer obligations", then "for"
# optional, then "high-risk". It matches wording, not meaning: it misses the
# practice told in other words ("Let's run the provider's CV ranking tool our
# own way and ignore their usage guidance, it is too slow"), and it fires on
# text that only names the practice, such as a refusal. Whether a text does
# the practice is judged in Layer 2.
#
# Legal citation: Regulation (EU) 2024/1689, Article 26(1), (2), (5) and (6)
# Effective: 2027-12-02 (Annex III high-risk systems; 2 August 2028 for high-risk systems under Annex I, Article 113, as amended by Regulation (EU) 2026/1744. Until then this is a readiness check, not a binding obligation. The condition does not read either date)
# Condition type: deterministic
# Enforcement layer: layer1
# Status: approved
# Approved by: Leo Celis on 2026-10-22 (via agent review per §5.1 amendment v1.1)
# ELI: http://data.europa.eu/eli/reg/2024/1689/art_26/oj
# Provision: Regulation (EU) 2024/1689, Article 26(1), (2), (5) and (6)

package complyedge.highrisk.art26_deployer_obligations

import rego.v1

import data.complyedge.shared.normalize

default violation := false

violation if {
	input.jurisdiction == "EU"
	pattern_match
}

pattern_match if {
	patterns := [
		"deploy(?:ing|er)?\\s+high[\\-\\s]?risk\\s+ai\\s+without\\s+(?:instructions|oversight|monitoring|logs)",
		"(?:ignor|disregard)\\w*\\s+(?:the\\s+)?(?:instructions\\s+for\\s+use|deployer\\s+obligations)\\s+(?:for\\s+)?high[\\-\\s]?risk",
	]

	text := lower(normalize.text)
	some pattern in patterns
	regex.match(pattern, text)
}

rule_id := "rego-art26-001"

citation := "Regulation (EU) 2024/1689, Article 26(1): Deployers of high-risk AI systems shall take appropriate technical and organisational measures to ensure they use such systems in accordance with the instructions for use accompanying the systems, pursuant to paragraphs 3 and 6. Article 26(2): Deployers shall assign human oversight to natural persons who have the necessary competence, training and authority, as well as the necessary support. Article 26(5): Deployers shall monitor the operation of the high-risk AI system on the basis of the instructions for use and, where relevant, inform providers in accordance with Article 72. Article 26(6): Deployers of high-risk AI systems shall keep the logs automatically generated by that high-risk AI system to the extent such logs are under their control, for a period appropriate to the intended purpose of the high-risk AI system, of at least six months, unless provided otherwise in applicable Union or national law, in particular in Union law on the protection of personal data."
severity := "high"

remediation := "Use the high-risk system per instructions, ensure oversight and monitoring, and retain logs. Readiness check, not yet a binding obligation: Article 26 applies from 2 December 2027 for Annex III high-risk systems and from 2 August 2028 for high-risk systems under Annex I (Article 113, as amended by Regulation (EU) 2026/1744)."

result := {
	"violation": violation,
	"rule_id": rule_id,
	"citation": citation,
	"severity": severity,
	"remediation": remediation,
}
