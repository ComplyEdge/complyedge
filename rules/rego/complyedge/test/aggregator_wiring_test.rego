test_prompt_security_tool_hijack_reported_when_it_fires if {
	agg := data.complyedge.prompt_security.result with data.complyedge.prompt_security.tool_hijack.violation as true
		with input as {"text": "x", "jurisdiction": "EU"}
	agg.violation
	leaf := data.complyedge.prompt_security.tool_hijack.result with data.complyedge.prompt_security.tool_hijack.violation as true
	some v in agg.violations
	v == leaf
	v.citation != ""
	data.complyedge.prompt_security.tool_hijack.rule_id in agg.rules_evaluated
}

# ---- us_corpus (1 leaves) ----

test_us_corpus_sox_material_disclosure_result_complete if complete(data.complyedge.us_corpus.sox_material_disclosure.result)

test_us_corpus_sox_material_disclosure_reported_when_it_fires if {
	agg := data.complyedge.us_corpus.result with data.complyedge.us_corpus.sox_material_disclosure.violation as true
		with input as {"text": "x", "jurisdiction": "US"}
	agg.violation
	leaf := data.complyedge.us_corpus.sox_material_disclosure.result with data.complyedge.us_corpus.sox_material_disclosure.violation as true
	some v in agg.violations
	v == leaf
	v.citation != ""
	data.complyedge.us_corpus.sox_material_disclosure.rule_id in agg.rules_evaluated
}
