# GENERATED by scripts/testing/gen_rego_aggregator_tests.py. Do not edit by hand.
#
# For every leaf: when it fires, its domain reports the leaf's own result
# (with the citation) in `violations` and its rule id in `rules_evaluated`,
# and the leaf's result carries every field the API reads.
# Run with: opa test rules/rego/ -v --run aggregator_wiring

package complyedge.aggregator_wiring_test

import rego.v1

severities := {"critical", "high", "medium", "low"}

complete(r) if {
	is_boolean(r.violation)
	startswith(r.rule_id, "rego-")
	count(trim_space(r.citation)) > 0
	severities[r.severity]
	count(trim_space(r.remediation)) > 0
}

